# Build AI From Here environment variables
# Copy this file to .env.local for local development, or set the same
# variables in the Vercel project settings at launch.
# Never commit real API keys or secrets.

# Public site URL (production value will be https://buildaifromhere.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pro AI Audit flow: BOOK FIRST, PAY AFTER (wired in lib/site.ts) ---
#
# Step 1 — Cal.com booking link for the audit call. CONNECTED.
# This is the live, public booking link. It is also the default value
# committed in lib/site.ts, so the site books correctly even with no
# env set. Setting this variable overrides the committed default.
NEXT_PUBLIC_CALCOM_AUDIT_LINK=https://cal.com/franklinbellamy/build-ai-from-here
#
# Step 3 — Stripe payment link for the $199 Pro AI Audit. NOT YET CONNECTED.
# The visitor pays AFTER the audit is scheduled, using this link.
# While empty, the pay-after button points at the booking section and
# the page shows a "payment link connects at launch" note.
NEXT_PUBLIC_STRIPE_AUDIT_PAYMENT_LINK=

# --- Later phases (not read by the current build) ---

# Stripe server-side (only if a custom checkout is ever built)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Resend (lead-magnet and form email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
